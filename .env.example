FRONTEND_PORT=8000
BACKEND_PORT=8001
BACKEND_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
BACKEND_API_KEY=

# SQLite is used when this is unset. To use a PostgreSQL container named
# "postgres" on cem_master_network, uncomment and fill in the password:
# BACKEND_DATABASE_URL=postgresql+psycopg://cem_user:change-me@postgres:5432/cem_master
