# Frontend only. Optional -- every value here has a working default, so
# `docker compose up` works with no .env at all.
#
# The backend and database settings that used to live here (DATABASE_URL,
# BACKEND_PORT, BACKEND_CORS_ORIGINS, BACKEND_API_KEY) have moved to
# cem-master-backend/.env.example, which is now the only place they are defined.
# This file no longer builds or configures the backend -- see compose.yaml.

# Host port the site is served on: http://localhost:8000
FRONTEND_PORT=8000
