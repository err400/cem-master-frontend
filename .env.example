FRONTEND_PORT=8000
BACKEND_PORT=8001
BACKEND_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
BACKEND_API_KEY=

# Required PostgreSQL connection. The database service must be named
# cem-database and attached to cem_master_network.
DATABASE_URL=postgresql+psycopg://cem_user:change-me@cem-database:5432/cem_master
